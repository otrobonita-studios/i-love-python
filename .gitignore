.env
.env.local
.env*
.venv/
__pycache__/
*.py[cod]
.coverage
coverage.xml
htmlcov/
.pytest_cache/
.pytest-tmp/
.mypy_cache/
.ruff_cache/
# Generated artifacts (CI YAML, hook, k6 JS) are checked in ON PURPOSE: they
# prove the pure-Python rule. Only the runtime telemetry cache is ignored.
generated/telemetry/
.hypothesis/
server.log
*.egg-info/
# Editor and agent-tool configs are local, not repo content. This tree
# names no vendor: AGENTS.md is the neutral standard, and any tool that
# wants its own directory can keep it untracked.
.claude/
.cursor/
.vscode/
.idea/
.DS_Store
# Podcast episodes are CDN-hosted (art/podcast_copy.py's Episode.href) and
# streamed by the browser, not bundled -- a local scratch copy for
# listening/verifying before wiring one in should never land in git.
podcasts/
